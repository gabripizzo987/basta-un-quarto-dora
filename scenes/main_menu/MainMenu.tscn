[node name="RichLeft" type="RichTextLabel" parent="PanelManual/PagesRow2"]
texture_filter = 1
custom_minimum_size = Vector2(250, 0)
layout_mode = 2
theme_override_colors/default_color = Color(0.184314, 0.145098, 0.0941176, 1)
theme_override_fonts/normal_font = ExtResource("4_oitky")
theme_override_font_sizes/normal_font_size = 16
bbcode_enabled = true
text = "[color=#2B2116][font=res://fonts/PixelOperator8-Bold.ttf]FATTORE Rh (positivo/negativo)[/font]

Oltre ad AB0 esiste il fattore Rh, legato  all’antigene D.

• Rh+: antigene D presente
• Rh−: antigene D assente


• Chi è Rh− può ricevere solo Rh−
• Chi è Rh+ può ricevere Rh+ o Rh−

"

[node name="RichRight" type="RichTextLabel" parent="PanelManual/PagesRow2"]
texture_filter = 1
custom_minimum_size = Vector2(240, -10)
layout_mode = 2
theme_override_colors/default_color = Color(0.184314, 0.145098, 0.0941176, 1)
theme_override_fonts/normal_font = ExtResource("4_oitky")
theme_override_font_sizes/normal_font_size = 16
bbcode_enabled = true
text = "👉 AB0 + Rh insieme formano: A+, A−, B+, B−, AB+, AB−, 0+, 0−."

