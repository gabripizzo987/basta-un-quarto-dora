[node name="RichLeft" type="RichTextLabel" parent="PanelManual/PagesRow"]
texture_filter = 1
custom_minimum_size = Vector2(250, 0)
layout_mode = 2
theme_override_colors/default_color = Color(0.184314, 0.145098, 0.0941176, 1)
theme_override_fonts/normal_font = ExtResource("4_oitky")
theme_override_font_sizes/normal_font_size = 16
bbcode_enabled = true
text = "
[color=#2B2116][font=res://fonts/PixelOperator8-Bold.ttf]GRUPPI SANGUIGNI: AB0[/font]

Il gruppo sanguigno dipende dagli antigeni presenti sui globuli rossi.

• Se hai antigene A → gruppo A
• Se hai antigene B → gruppo B
• Se hai A e B → gruppo AB
• Se non hai né A né B → gruppo 0
"

[node name="RichRight" type="RichTextLabel" parent="PanelManual/PagesRow"]
texture_filter = 1
custom_minimum_size = Vector2(240, -10)
layout_mode = 2
theme_override_colors/default_color = Color(0.184314, 0.145098, 0.0941176, 1)
theme_override_fonts/normal_font = ExtResource("4_oitky")
bbcode_enabled = true
text = "Il corpo produce anticorpi contro gli antigeni che non possiede:
• A → anticorpi anti-B
• B → anticorpi anti-A
• AB → nessun anti-A/anti-B
• 0 → anti-A e anti-B"

[node name="PagesRow2" type="HBoxContainer" parent="PanelManual"]
visible = false
custom_minimum_size = Vector2(0, 220)
